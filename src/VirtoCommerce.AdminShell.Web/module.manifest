<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.AdminShell</id>
  <version>3.1093.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1092.0</platformVersion>
  <dependencies />

  <title>Admin Shell</title>
  <description>Vue (vc-shell) back office (Commerce Manager) for the Virto Commerce Platform. Without an admin UI module the platform runs API only.</description>

  <authors>
    <author>Alexander Siniouguine</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <groups>
    <group>commerce</group>
  </groups>

  <apps>
    <app id="admin-shell">
      <title>Admin Shell</title>
      <description>Virto Commerce admin</description>
      <iconUrl>Modules/$(VirtoCommerce.AdminShell)/Content/logo.svg</iconUrl>
      <placement>AppMenu</placement>
      <!-- An admin UI that can own the site root (VirtoCommerce:PlatformUI:RootApp, platform 3.1093.0+; older platforms
           ignore it). With the AngularJS admin (priority 100) installed too, that one owns the root unless RootApp says otherwise. -->
      <adminUI priority="50" />
    </app>
  </apps>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-admin-shell</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.AdminShell)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.AdminShell.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.AdminShell.Web.Module, VirtoCommerce.AdminShell.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>admin shell</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
