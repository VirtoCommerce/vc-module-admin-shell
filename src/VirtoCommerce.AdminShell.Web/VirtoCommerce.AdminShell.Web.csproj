<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>NU1608, 1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- the vc-shell host app (built by vc-build BuildCustomApp into Content/admin-shell) -->
    <Compile Remove="App\**" />
    <Content Remove="App\**" />
    <EmbeddedResource Remove="App\**" />
    <None Remove="App\**" />
    <Content Remove="Content\admin-shell\**" />
    <None Remove="Content\admin-shell\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.AdminShell.Core\VirtoCommerce.AdminShell.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.AdminShell.Data\VirtoCommerce.AdminShell.Data.csproj" />
  </ItemGroup>
</Project>
