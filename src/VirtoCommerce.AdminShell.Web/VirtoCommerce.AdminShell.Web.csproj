<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>NU1608, 1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- the vc-shell host app (built by vc-build BuildCustomApp into Content/admin-shell) -->
    <Compile Remove="App\**" />
    <Content Remove="App\**" />
    <EmbeddedResource Remove="App\**" />
    <None Remove="App\**" />
    <!-- the platform admin screens plugin (Module Federation remote, built by yarn build into plugins/admin-shell) -->
    <Compile Remove="PlatformUI\**" />
    <Content Remove="PlatformUI\**" />
    <EmbeddedResource Remove="PlatformUI\**" />
    <None Remove="PlatformUI\**" />
    <Compile Remove="plugins\**" />
    <Content Remove="plugins\**" />
    <EmbeddedResource Remove="plugins\**" />
    <None Remove="plugins\**" />
    <Content Remove="Content\admin-shell\**" />
    <None Remove="Content\admin-shell\**" />
  </ItemGroup>
  <ItemGroup>
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.AdminShell.Core\VirtoCommerce.AdminShell.Core.csproj" />
  </ItemGroup>
</Project>
